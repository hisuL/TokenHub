TOKENHUB_INSTALL_ROOT=/opt/tokenhub-silang
TOKENHUB_BIND_ADDRESS=0.0.0.0
TOKENHUB_PORT=8080
TOKENHUB_PUBLIC_BASE_URL=http://192.168.1.100:8080

# These values are generated by install.sh on first installation.
TOKENHUB_ADMIN_TOKEN=
TOKENHUB_BOOTSTRAP_ADMIN_PASSWORD=
TOKENHUB_SECRET_KEY=
POSTGRES_DB=tokenhub
POSTGRES_USER=tokenhub
POSTGRES_PASSWORD=

TOKENHUB_DB_MAX_OPEN_CONNS=25
TOKENHUB_DB_MAX_IDLE_CONNS=5
TOKENHUB_UPSTREAM_NON_STREAM_TIMEOUT_SECONDS=900
TOKENHUB_UPSTREAM_STREAM_IDLE_TIMEOUT_SECONDS=900
